# ==============================================================================
# CONFIGURACIÓN DEL AGENTE PERSONAL DE FINANZAS
# Copia este archivo como .env y rellena con tus valores reales.
# ==============================================================================

# --- TELEGRAM BOT ---
# Token otorgado por @BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# IDs numéricos de Telegram autorizados (separados por coma).
# Solo estos usuarios podrán interactuar con el bot.
# Para obtener tu ID, puedes escribirle al bot @userinfobot en Telegram.
TELEGRAM_ALLOWED_USER_IDS="123456789"

# Token secreto para verificar que las peticiones del webhook provienen realmente de Telegram.
# Puedes generar uno seguro con: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET="a_very_secret_random_token_for_telegram_webhook"

# --- INTELIGENCIA ARTIFICIAL (GEMINI) ---
# Clave de API de Google AI Studio (gratuita en https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSy..."
# Modelo a utilizar (gemini-2.0-flash recomendado por velocidad y precisión de schemas)
GEMINI_MODEL="gemini-2.0-flash"

# --- BASE DE DATOS (POSTGRESQL) ---
# URL de conexión a PostgreSQL (Supabase, Neon o PostgreSQL local).
# En Supabase: Settings -> Database -> Connection string (URI)
DATABASE_URL="postgresql://postgres:yourpassword@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# --- SEGURIDAD DEL DASHBOARD ---
# Contraseña para acceder al dashboard web (usuario único)
DASHBOARD_PASSWORD="change_this_to_a_secure_password"
# Clave secreta para firmar sesiones/cookies (mínimo 32 caracteres)
SESSION_SECRET="super_secret_session_encryption_key_at_least_32_chars"

# --- LOCALIZACIÓN & CONFIGURACIÓN REGIONAL ---
DEFAULT_TIMEZONE="America/Santiago"
DEFAULT_CURRENCY="CLP"

# --- URL BASE DEL SERVICIO ---
# URL pública donde está desplegada la aplicación (para webhooks)
# En desarrollo: http://localhost:3000 o url de ngrok
# En producción: https://tu-proyecto.vercel.app
APP_URL="http://localhost:3000"
